{
  "description": "Inject bounded local Mindmory context without MCP and checkpoint completed Codex turns",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/integrations/checkpoint-hook.sh codex",
            "timeout": 10,
            "statusMessage": "Loading bounded local memory",
            "additionalContextLimit": 160
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/integrations/checkpoint-hook.sh codex",
            "async": true,
            "timeout": 10,
            "statusMessage": "Checkpointing assistant response to local Mindmory"
          }
        ]
      }
    ]
  }
}
